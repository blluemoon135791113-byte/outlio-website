{
  "name": "outlio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "ext:build": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/build.mjs --target=firefox",
    "ext:chrome": "node extensions/scripts/build.mjs --target=chrome",
    "ext:firefox": "node extensions/scripts/build.mjs --target=firefox",
    "ext:dev": "node extensions/scripts/build.mjs --target=chrome --dev",
    "db:types": "node scripts/gen-db-types.mjs",
    "ext:package": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/package.mjs --target=chrome",
    "ext:package:firefox": "node extensions/scripts/build.mjs --target=firefox && node extensions/scripts/package.mjs --target=firefox",
    "ext:assets": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/screenshots.mjs",
    "test:email": "docker rm -f outlio-greenmail >/dev/null 2>&1; docker run -d --name outlio-greenmail -p 2525:3025 -p 993:3993 -e GREENMAIL_OPTS='-Dgreenmail.setup.test.all -Dgreenmail.hostname=0.0.0.0 -Dgreenmail.users=sender:senderpw@acme.example,prospect:prospectpw@buyer.example' greenmail/standalone:2.1.4 >/dev/null && sleep 20 && vitest run tests/integration/email-send-worker.test.ts tests/integration/email-reply-sync.test.ts tests/integration/email-smtp.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@types/three": "^0.185.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "geist": "^1.7.2",
    "imapflow": "^1.7.6",
    "libphonenumber-js": "^1.13.10",
    "mailparser": "^3.9.17",
    "next": "16.3.0",
    "nodemailer": "^9.0.6",
    "page-agent": "^1.12.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/country-list": "^2.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

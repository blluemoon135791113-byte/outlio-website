{
  "name": "outlio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ext:build": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/build.mjs --target=firefox",
    "ext:chrome": "node extensions/scripts/build.mjs --target=chrome",
    "ext:firefox": "node extensions/scripts/build.mjs --target=firefox",
    "ext:dev": "node extensions/scripts/build.mjs --target=chrome --dev",
    "db:types": "supabase gen types typescript --project-id ptewhpmxzenbmxlizxhu --schema public > types/database.ts",
    "ext:package": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/package.mjs --target=chrome",
    "ext:package:firefox": "node extensions/scripts/build.mjs --target=firefox && node extensions/scripts/package.mjs --target=firefox",
    "ext:assets": "node extensions/scripts/build.mjs --target=chrome && node extensions/scripts/screenshots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "libphonenumber-js": "^1.13.10",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/country-list": "^2.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

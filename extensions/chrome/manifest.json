{
  "manifest_version": 3,
  "name": "Outlio Capture",
  "version": "0.2.0",
  "description": "Capture Sales Navigator lead and account lists you open yourself. Manage capture from Outlio's browser side panel.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "activeTab", "sidePanel"],

  "host_permissions": [
    "https://www.linkedin.com/sales/*",
    "https://app.outlio.io/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": { "default_path": "panel.html" },

  "action": {
    "default_title": "Open Outlio side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.outlio.io/extension/connect*"],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}

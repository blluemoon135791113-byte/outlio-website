PORT=8787
# Use `request` on free hosts that sleep; use `background` for an always-on worker.
WORKER_MODE=background
MCP_BEARER_TOKEN=
DATABASE_URL=
DATABASE_SSL_MODE=require
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Safe, bounded workflow defaults. Per-request values may only reduce or stay
# within the service-level ceilings defined in src/config.ts.
MAX_QUERIES=10
RESULTS_PER_QUERY=8
MAX_URLS=25
CONCURRENT_REQUESTS=6
PER_DOMAIN_CONCURRENCY=2
REQUEST_TIMEOUT_MS=12000
MAX_PAGE_BYTES=2000000
RELEVANCE_THRESHOLD=0.42
MAX_GEMINI_CALLS=8
CACHE_TTL_SECONDS=86400
DDG_MIN_INTERVAL_MS=1500

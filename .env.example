# Existing Supabase application configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXPORT_BUCKET=exports

# Canonical public application URL. Use http://localhost:3000 only in local development.
APP_URL=

# Base64-encoded 32-byte key used for AES-256-GCM encryption of user/provider credentials.
# Generate locally with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Google (one connection supports Google Sheets and Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Production value. Override with http://localhost:3000/api/integrations/hubspot/callback locally.
HUBSPOT_REDIRECT_URI=https://app.outlio.io/api/integrations/hubspot/callback

# Salesforce External Client App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Production value. Override with http://localhost:3000/api/integrations/salesforce/callback locally.
SALESFORCE_REDIRECT_URI=https://app.outlio.io/api/integrations/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Microsoft Graph / OneDrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# Dropbox (configure the app for App Folder access)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=

# Optional server-only Clay webhook used for deployment smoke tests.
# Production users connect their own webhook from Settings; these values are never sent to browsers.
CLAY_TEST_WEBHOOK_URL=
CLAY_TEST_AUTH_TOKEN=

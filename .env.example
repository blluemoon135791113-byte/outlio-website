# Existing Supabase application configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXPORT_BUCKET=exports

# Canonical public application URL. Use http://localhost:3000 only in local development.
APP_URL=

# ---------------------------------------------------------------------------
# Paddle Billing
#
# Required. There are deliberately no environment defaults: a missing value
# must stop startup rather than accidentally using the wrong Paddle account.
# Use `production` with live credentials and `sandbox` with sandbox credentials.
# ---------------------------------------------------------------------------
PADDLE_ENVIRONMENT=
# Public browser token only (`live_...` in production, `test_...` in sandbox).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only API key. Never prefix this with NEXT_PUBLIC_.
PADDLE_API_KEY=
# Signing secret for the notification destination, not the API key.
PADDLE_WEBHOOK_SECRET=

# Permanent Paddle price IDs backing the three tiers.
PADDLE_LEAD_ENGINE_MONTH_PRICE_ID=
PADDLE_LEAD_ENGINE_YEAR_PRICE_ID=
PADDLE_PRO_MONTH_PRICE_ID=
PADDLE_PRO_YEAR_PRICE_ID=
PADDLE_PRO_HUBBLE_MONTH_PRICE_ID=
PADDLE_PRO_HUBBLE_YEAR_PRICE_ID=

# Base64-encoded 32-byte key used for AES-256-GCM encryption of user/provider credentials.
# Generate locally with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Google (one connection supports Google Sheets and Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Production value. Override with http://localhost:3000/api/integrations/hubspot/callback locally.
HUBSPOT_REDIRECT_URI=https://app.outlio.io/api/integrations/hubspot/callback

# Salesforce External Client App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Production value. Override with http://localhost:3000/api/integrations/salesforce/callback locally.
SALESFORCE_REDIRECT_URI=https://app.outlio.io/api/integrations/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Microsoft Graph / OneDrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# Dropbox (configure the app for App Folder access)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=

# Optional server-only Clay webhook used for deployment smoke tests.
# Production users connect their own webhook from Settings; these values are never sent to browsers.
CLAY_TEST_WEBHOOK_URL=
CLAY_TEST_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Intelligence layer (Phases 3+)
#
# ⚠️ EVERY VALUE BELOW IS SERVER-ONLY. None may ever be prefixed NEXT_PUBLIC_.
# The browser talks to Outlio; Outlio talks to providers. Never the reverse.
# ---------------------------------------------------------------------------

# LLM. Used for query planning and result explanation only — never to state a
# fact. Gemini is the default; Groq is the configured alternative.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional override, e.g. "gemini" or "groq". Falls back to whichever vendor
# actually has a key, so a typo degrades rather than taking planning down.
LLM_PROVIDER=
# Optional model overrides. The pinned Gemini default is gemini-3.6-flash.
GEMINI_MODEL=
GROQ_MODEL=

# OpenAI-compatible LLM router. Reached over the same OpenAI-style chat
# completions contract as Groq, so it needs no bespoke adapter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Cerebras cloud inference. OpenAI-compatible chat completions contract.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Backboard (backboard.io). Unified LLM + memory API. Authenticates with the
# X-API-Key header, not a Bearer token. json_output=true is used for planning.
BACKBOARD_API_KEY=
BACKBOARD_MODEL=
# Which underlying model vendor Backboard routes to (e.g. "openai", "anthropic").
BACKBOARD_LLM_PROVIDER=

# Ask Hubble RAG. All values are optional and server-only. Retrieval falls back
# to lexical ranking when Ollama is absent; hosted LLMs remain available when a
# local LLM model is not explicitly opted in.
OLLAMA_URL=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768
# No default on purpose: setting this opts Hubble into local synthesis.
OLLAMA_LLM_MODEL=

# Ask Hubble search waterfall, cheapest first. A remote SearXNG URL also needs
# an auth token; loopback development instances do not.
SEARXNG_URL=
SEARXNG_AUTH_TOKEN=
# Optional comma-separated engine allowlist. Useful when datacenter IPs are
# blocked by some scraper-backed engines (for example: bing).
SEARXNG_ENGINES=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=

# Licensed web search. Powers company news, hiring signals, and the domain
# discovery step that finds a company website when the captured lead has none.
TAVILY_API_KEY=

# UK official company registry. Free public-data API; Basic authentication uses
# this key as the username. Used only for registry-specific fields after an
# exact, unambiguous legal-name match.
COMPANIES_HOUSE_API_KEY=

# Public technical presence. A fine-grained token with NO scopes is sufficient —
# only public repository data is read.
GITHUB_TOKEN=

# Contact enrichment. Email costs 1 credit per match; mobile costs 10, so a
# phone number is only ever requested when a plan explicitly asks for one.
# Re-enriching the same record within 90 days is free, which the field TTLs
# are set to exploit.
PROSPEO_API_KEY=

# Second provider in the email waterfall. EMAIL ONLY: Apollo delivers phone
# numbers asynchronously to a webhook_url, which this product has no route for,
# so the phone path is deliberately unimplemented rather than half-wired.
APOLLO_API_KEY=

# Google PageSpeed Insights. Used for its Lighthouse "stack packs", which name
# the CMS and framework a site runs on — official-API tech detection rather than
# inferred from markup. Slow per URL, and requires a known domain first.
PAGESPEED_API_KEY=

# No key required, listed so the dependency is discoverable:
#   Wikidata REST    https://www.wikidata.org/w/rest.php/wikibase/v1
#     Supplies the official website as a STATED FACT, which is a better source
#     for a company domain than inferring one from search results. Coverage is
#     notability-based: strong for large companies, thin for SMBs.

# Provider waterfall order, by tool category. Format:
#   funding=alpha>beta,tech_stack=one>two
# Unknown categories and empty names are ignored rather than failing closed.
INTELLIGENCE_PROVIDER_ORDER=

# Per-field cache overrides, in seconds. Format: field=seconds,field=seconds
# Lets a TTL be shortened during an incident without a deploy.
INTELLIGENCE_TTL_OVERRIDES=

# No key required, listed so the dependency is discoverable:
#   GDELT DOC 2.0    https://api.gdeltproject.org/api/v2/doc/doc
#   GLEIF LEI        https://api.gleif.org/api/v1/lei-records
#   Hacker News      https://hn.algolia.com/api/v1/search
#   SEC ticker/CIK   https://www.sec.gov/files/company_tickers.json
#   SEC submissions  https://data.sec.gov/submissions/CIK##########.json
